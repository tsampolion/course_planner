<?xml version="1.0" encoding="utf-8"?>
<!-- Plans are a few kilobytes of JSON: back them up and carry them to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="plans.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="plans.json" />
    </device-transfer>
</data-extraction-rules>
